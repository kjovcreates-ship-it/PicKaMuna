rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Existing Duo Booth rules. Testing only.
    match /photoboothRooms/{roomId} {
      allow get, create, update: if roomId.matches('[A-Z2-9]{6}')
        && request.time < timestamp.date(2027, 12, 31);
      allow list, delete: if false;
      match /{candidateCollection}/{candidateId} {
        allow create: if candidateCollection in ['hostCandidates', 'guestCandidates']
          && roomId.matches('[A-Z2-9]{6}')
          && request.time < timestamp.date(2027, 12, 31);
        allow get, list: if candidateCollection in ['hostCandidates', 'guestCandidates']
          && request.time < timestamp.date(2027, 12, 31);
        allow update, delete: if false;
      }
    }
    // Group Booth beta: temporary public testing rules, NOT production-safe.
    // Room codes are not authentication. Anyone with the code can read signals.
    match /groupRooms/{roomId} {
      allow get: if roomId.matches('[A-Z2-9]{6}');
      allow list, delete: if false;
      allow create: if roomId.matches('[A-Z2-9]{6}')
        && request.resource.data.members.size() == 1
        && request.time < timestamp.date(2027, 12, 31);
      allow update: if roomId.matches('[A-Z2-9]{6}')
        && request.resource.data.members is list
        && request.resource.data.members.size() <= 4
        && request.time < timestamp.date(2027, 12, 31);
      match /signals/{signalId} {
        allow get, list: if roomId.matches('[A-Z2-9]{6}')
          && request.time < timestamp.date(2027, 12, 31);
        allow create: if roomId.matches('[A-Z2-9]{6}')
          && request.resource.data.keys().hasAll(['from','to','type','value'])
          && request.time < timestamp.date(2027, 12, 31);
        allow update, delete: if false;
      }
    }
  }
}
