// OPTIONAL hardened rules. Requires Firebase Authentication > Sign-in method > Anonymous enabled.
// Also add anonymous sign-in in both JS modules before deploying these rules.
// Do not deploy this file by itself; see SECURITY-SETUP.md.
rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  match /photoboothRooms/{roomId} {
   allow get: if request.auth != null && roomId.matches('[A-HJ-NP-Z2-9]{6}');
   allow list, delete: if false;
   allow create: if request.auth != null && roomId.matches('[A-HJ-NP-Z2-9]{6}')
     && request.resource.data.status == 'waiting'
     && request.resource.data.keys().hasAll(['createdAt','deleteAfter']);
   allow update: if request.auth != null && roomId.matches('[A-HJ-NP-Z2-9]{6}')
     && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','offer','answer']);
   match /{candidateCollection}/{candidateId} {
    allow get,list: if request.auth != null && candidateCollection in ['hostCandidates','guestCandidates'];
    allow create: if request.auth != null && candidateCollection in ['hostCandidates','guestCandidates'];
    allow update,delete: if false;
   }
  }
  match /groupRooms/{roomId} {
   allow get: if request.auth != null && roomId.matches('[A-HJ-NP-Z2-9]{6}');
   allow list,delete: if false;
   allow create: if request.auth != null && roomId.matches('[A-HJ-NP-Z2-9]{6}')
     && request.resource.data.members.size()==1
     && request.resource.data.keys().hasAll(['createdAt','deleteAfter','host','expiresAt']);
   allow update: if request.auth != null && roomId.matches('[A-HJ-NP-Z2-9]{6}')
     && request.resource.data.members is list && request.resource.data.members.size()<=4
     && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members']);
   match /signals/{signalId} {
    allow get,list: if request.auth != null;
    allow create: if request.auth != null && request.resource.data.keys().hasAll(['from','to','type','value']);
    allow update,delete: if false;
   }
  }
 }
}
